# ==============================================================================
# DOCKERFILE - STATIC NGINX WEB SERVER (INDEX.HTML, CSS, JS, ASSETS)
# ==============================================================================

FROM nginx:alpine

# Salin file statis ke direktori web root Nginx
COPY index.html style.css script.js /usr/share/nginx/html/
COPY assets /usr/share/nginx/html/assets/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
